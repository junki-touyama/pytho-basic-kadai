        "class Human:\n",
        "\n",
        "  def __init__(self, name, age):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "  def check_adult(self):\n",
        "    if self.age >= 20:\n",
        "      print(f\"{self.name}は、大人です。\")\n",
        "    else:\n",
        "      print(f\"{self.name}は、まだ子どもです。\")\n",
        "\n",
        "human_a = Human(\"當山純輝\", 32)\n",
        "human_a.check_adult()"
      ],
